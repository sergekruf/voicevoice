.mltools/

# RUPunct: сама Core ML модель (~56 МБ) — НЕ в git; лёгкие файлы (токенизатор,
# labels, README) коммитятся, чтобы свежий клон собирался: Package.swift объявляет
# папку ресурсом, и без неё swift build падает. Без модели приложение работает,
# нейро-пунктуация просто недоступна (RUPunctService деградирует в .failed).
Sources/VoiceVoice/Resources/RUPunct/RUPunct_small.mlpackage/
Sources/VoiceVoice/Resources/RUPunct/*.mlmodelc/
